# ===================================
# Task Management System - Frontend Test Dockerfile
# ===================================
# Generated for TSK-009-ENV-frontend-dockerfile
# Project: Task Management System
# Component: Frontend React Application (Test)
# Purpose: Optimized for automated testing and CI/CD

FROM node:20.11.0-alpine AS test

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    dumb-init \
    curl \
    ca-certificates \
    && rm -rf /var/cache/apk/*

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S frontend -u 1001 -G nodejs

# Set test environment
ENV NODE_ENV=test
ENV CI=true
ENV COVERAGE_THRESHOLD=90
ENV JEST_WORKERS=2
ENV GENERATE_SOURCEMAP=false

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./
COPY vite.config.ts ./
COPY jest.config.js ./

# Install all dependencies (including devDependencies for testing)
RUN npm ci --silent && \
    npm cache clean --force

# Copy source code
COPY --chown=frontend:nodejs . .

# Create test directories
RUN mkdir -p coverage test-results && \
    chown -R frontend:nodejs coverage test-results

# Switch to non-root user
USER frontend

# Health check for test environment
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Run tests with coverage
CMD ["dumb-init", "npm", "run", "test:ci"]
