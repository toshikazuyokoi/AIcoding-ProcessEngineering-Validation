# ===================================
# Task Management System - Frontend Environment Variables
# ===================================
# Generated for TSK-050-ENV-frontend-env-example
# Project: Task Management System
# Component: Frontend React Application Environment Configuration Template
# Purpose: Define all required frontend environment variables with example values

# ===================================
# Application Configuration
# ===================================

# Node.js Environment
# Options: development, production, test
NODE_ENV=development

# Development Server Configuration
PORT=3000

# Application Information
REACT_APP_APP_NAME=Task Management System
REACT_APP_APP_VERSION=1.0.0
REACT_APP_SUPPORT_EMAIL=support@taskmanagement.com

# ===================================
# API Connection Configuration
# ===================================

# Backend API Configuration
# Backend server URL for API calls
REACT_APP_API_URL=http://localhost:8000

# WebSocket Configuration
# WebSocket server URL for real-time features
REACT_APP_WS_URL=ws://localhost:8000

# API Timeout and Retry Settings
REACT_APP_API_TIMEOUT=30000
REACT_APP_API_RETRY_ATTEMPTS=3
REACT_APP_API_RETRY_DELAY=1000

# API Version
REACT_APP_API_VERSION=v1

# ===================================
# Authentication Configuration
# ===================================

# JWT Token Storage
# Local storage key for JWT access token
REACT_APP_JWT_STORAGE_KEY=task-mgmt-token

# Refresh Token Storage
# Local storage key for JWT refresh token
REACT_APP_REFRESH_TOKEN_KEY=task-mgmt-refresh-token

# Authentication Redirect URLs
REACT_APP_AUTH_REDIRECT_URL=/dashboard
REACT_APP_LOGIN_REDIRECT_URL=/login
REACT_APP_LOGOUT_REDIRECT_URL=/

# Session Configuration
REACT_APP_SESSION_TIMEOUT=3600000
REACT_APP_SESSION_WARNING_TIME=300000

# ===================================
# Development Environment Settings
# ===================================

# File Watching Configuration
# Enable polling for file changes (useful in Docker/VM environments)
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# React Development Features
# Enable React Fast Refresh for hot reloading
FAST_REFRESH=true

# Source Map Generation
# Generate source maps for debugging (disable in production)
GENERATE_SOURCEMAP=true

# Development Tools
REACT_APP_DEBUG_MODE=true
REACT_APP_SHOW_DEV_TOOLS=true

# ===================================
# Build and Deployment Configuration
# ===================================

# Build Information
REACT_APP_BUILD_VERSION=dev-build
REACT_APP_BUILD_DATE=2024-01-01T00:00:00Z
REACT_APP_ENVIRONMENT=development

# Public URL Configuration
# Base URL for static assets (leave empty for relative paths)
PUBLIC_URL=

# Bundle Analysis
ANALYZE_BUNDLE=false

# Inline Runtime Chunk
INLINE_RUNTIME_CHUNK=false

# ===================================
# Feature Flags Configuration
# ===================================

# Feature Toggle Settings
REACT_APP_FEATURE_REAL_TIME_UPDATES=true
REACT_APP_FEATURE_DARK_MODE=true
REACT_APP_FEATURE_NOTIFICATIONS=true
REACT_APP_FEATURE_TASK_COMMENTS=true
REACT_APP_FEATURE_FILE_UPLOADS=true
REACT_APP_FEATURE_TASK_TEMPLATES=false
REACT_APP_FEATURE_ADVANCED_SEARCH=false

# Experimental Features
REACT_APP_EXPERIMENTAL_FEATURES=false

# ===================================
# UI and UX Configuration
# ===================================

# Theme Configuration
REACT_APP_DEFAULT_THEME=light
REACT_APP_THEME_STORAGE_KEY=task-mgmt-theme

# Language and Localization
REACT_APP_DEFAULT_LANGUAGE=en
REACT_APP_LANGUAGE_STORAGE_KEY=task-mgmt-language

# Pagination Settings
REACT_APP_DEFAULT_PAGE_SIZE=20
REACT_APP_MAX_PAGE_SIZE=100

# File Upload Settings
REACT_APP_MAX_FILE_SIZE=10485760
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ===================================
# External Services Configuration
# ===================================

# Google Services
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id
REACT_APP_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Error Tracking
REACT_APP_SENTRY_DSN=your-sentry-dsn
REACT_APP_SENTRY_ENVIRONMENT=development

# Monitoring and Analytics
REACT_APP_ANALYTICS_ENABLED=false
REACT_APP_PERFORMANCE_MONITORING=false

# ===================================
# Security Configuration
# ===================================

# Content Security Policy
REACT_APP_CSP_ENABLED=true

# HTTPS Configuration
HTTPS=false
SSL_CRT_FILE=
SSL_KEY_FILE=

# Security Headers
REACT_APP_SECURITY_HEADERS_ENABLED=true

# ===================================
# Performance Configuration
# ===================================

# Code Splitting
REACT_APP_CODE_SPLITTING_ENABLED=true

# Service Worker
REACT_APP_SERVICE_WORKER_ENABLED=false

# Caching Strategy
REACT_APP_CACHE_STRATEGY=cache-first
REACT_APP_CACHE_DURATION=3600000

# Lazy Loading
REACT_APP_LAZY_LOADING_ENABLED=true

# ===================================
# Testing Configuration
# ===================================

# Test Environment Settings
CI=false
COVERAGE_THRESHOLD=90
JEST_WORKERS=2

# E2E Testing
REACT_APP_E2E_BASE_URL=http://localhost:3000
REACT_APP_E2E_API_URL=http://localhost:8000

# Test Data
REACT_APP_USE_MOCK_DATA=false
REACT_APP_MOCK_API_DELAY=500

# ===================================
# Logging and Debugging Configuration
# ===================================

# Logging Configuration
REACT_APP_LOG_LEVEL=debug
REACT_APP_LOG_TO_CONSOLE=true
REACT_APP_LOG_TO_SERVER=false

# Debug Information
REACT_APP_SHOW_REDUX_DEVTOOLS=true
REACT_APP_SHOW_PERFORMANCE_METRICS=false

# ===================================
# Production-Specific Configuration
# ===================================
# Uncomment and configure for production deployment

# Production API URLs
# REACT_APP_API_URL=https://api.taskmanagement.com
# REACT_APP_WS_URL=wss://api.taskmanagement.com

# Production Build Settings
# GENERATE_SOURCEMAP=false
# REACT_APP_DEBUG_MODE=false
# REACT_APP_SHOW_DEV_TOOLS=false

# Production Security
# HTTPS=true
# REACT_APP_CSP_ENABLED=true
# REACT_APP_SECURITY_HEADERS_ENABLED=true

# Production Performance
# REACT_APP_SERVICE_WORKER_ENABLED=true
# REACT_APP_CODE_SPLITTING_ENABLED=true

# Production Analytics
# REACT_APP_ANALYTICS_ENABLED=true
# REACT_APP_PERFORMANCE_MONITORING=true

# ===================================
# Docker and Container Configuration
# ===================================

# Container-specific settings
CONTAINER_NAME=task-management-frontend
CONTAINER_RESTART_POLICY=unless-stopped

# Docker Compose Override
COMPOSE_PROJECT_NAME=task-management

# ===================================
# Notes & Documentation
# ===================================
# 
# 1. Copy this file to .env and update values for your environment
# 2. Never commit .env files to version control
# 3. All REACT_APP_ prefixed variables are embedded in the build
# 4. Non-REACT_APP_ variables are only available during build time
# 5. Restart development server after changing environment variables
# 6. Use HTTPS=true for production deployments
# 7. Configure proper API URLs for production environment
# 8. Enable service worker and analytics for production
# 9. Disable debug features and source maps in production
# 10. Set appropriate feature flags for your deployment stage
#
# For more information, see:
# - README.md
# - docs/deployment/frontend-setup.md
# - docs/configuration/environment-variables.md
