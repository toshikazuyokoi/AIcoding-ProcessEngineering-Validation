# ===================================
# Task Management System - Frontend Development Dockerfile
# ===================================
# Generated for TSK-009-ENV-frontend-dockerfile
# Project: Task Management System
# Component: Frontend React Application (Development)
# Purpose: Optimized for development with hot reload and fast refresh

FROM node:20.11.0-alpine AS development

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    dumb-init \
    curl \
    git \
    ca-certificates \
    && rm -rf /var/cache/apk/*

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S frontend -u 1001 -G nodejs

# Set development environment
ENV NODE_ENV=development
ENV PORT=3000
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true
ENV FAST_REFRESH=true

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./
COPY vite.config.ts ./

# Install all dependencies (including devDependencies)
RUN npm ci --silent && \
    npm cache clean --force

# Copy source code
COPY --chown=frontend:nodejs . .

# Create necessary directories
RUN mkdir -p build dist coverage && \
    chown -R frontend:nodejs build dist coverage

# Switch to non-root user
USER frontend

# Expose development port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:3000 || exit 1

# Start development server with hot reload
CMD ["dumb-init", "npm", "run", "dev"]
