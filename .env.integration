# ===================================
# Integration Test Environment Variables
# ===================================
# Generated for TSK-IT-000-001-TestEnvironment
# Project: Task Management System - Integration Test
# Environment: Integration Test
# Purpose: Integration & E2E testing configuration

# ===================================
# Application Configuration
# ===================================
NODE_ENV=integration
PORT=8002
LOG_LEVEL=warn
TZ=UTC

# ===================================
# Database Configuration
# ===================================
DATABASE_URL=postgresql://integration_user:integration_password_123@localhost:5434/taskdb_integration
POSTGRES_DB=taskdb_integration
POSTGRES_USER=integration_user
POSTGRES_PASSWORD=integration_password_123
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# ===================================
# Redis Configuration
# ===================================
REDIS_URL=redis://localhost:6381
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

# ===================================
# JWT Configuration
# ===================================
JWT_SECRET=integration_jwt_secret_key_for_testing_only_do_not_use_in_production
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ===================================
# Test Configuration
# ===================================
TEST_TIMEOUT=60000
JEST_WORKERS=4
COVERAGE_THRESHOLD=85
TEST_TYPE=integration

# ===================================
# Frontend Configuration
# ===================================
REACT_APP_API_URL=http://localhost:8002
REACT_APP_ENV=integration
CI=true
GENERATE_SOURCEMAP=false

# ===================================
# E2E Test Configuration
# ===================================
BASE_URL=http://localhost:3000
API_URL=http://localhost:8002
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
HEADLESS=true
E2E_TIMEOUT=120000
E2E_RETRIES=2
E2E_WORKERS=2

# ===================================
# Docker Configuration
# ===================================
COMPOSE_PROJECT_NAME=integration-test
COMPOSE_FILE=docker-compose.integration-test.yml

# ===================================
# Logging Configuration
# ===================================
LOG_FORMAT=json
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# ===================================
# Performance Configuration
# ===================================
MAX_MEMORY=512mb
MAX_CPU=2
HEALTHCHECK_INTERVAL=15s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=5

# ===================================
# Security Configuration
# ===================================
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=1000
SESSION_SECRET=integration_session_secret_for_testing_only

# ===================================
# Test Data Configuration
# ===================================
SEED_DATA=true
CLEAN_DB_ON_START=true
TEST_USER_COUNT=10
TEST_TASK_COUNT=100
TEST_CATEGORY_COUNT=5

# ===================================
# Monitoring Configuration
# ===================================
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_PATH=/health
STATUS_CHECK_PATH=/status
