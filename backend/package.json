{
  "name": "task-management-backend",
  "version": "1.0.0",
  "description": "Task Management System Backend - Process Engineering Approach Implementation",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.2.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "dev:debug": "ts-node-dev --respawn --transpile-only --exit-child --inspect=0.0.0.0:9229 src/index.ts",
    "build": "tsc && npm run build:copy-assets",
    "build:copy-assets": "node -e \"try { require('fs').cpSync('prisma', 'dist/prisma', { recursive: true }); } catch (e) { console.log('No prisma directory to copy'); }\"",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=src",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "playwright test --config=tests/config/playwright.config.ts",
    "test:e2e:headed": "playwright test --config=tests/config/playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config=tests/config/playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:ci": "jest --coverage --ci --watchAll=false --passWithNoTests",
    "lint": "eslint src config --ext .ts --fix",
    "lint:check": "eslint src config --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"config/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"config/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "quality-check": "npm run lint:check && npm run format:check && npm run type-check && npm run test:ci",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "security:audit": "npm audit --audit-level moderate",
    "security:fix": "npm audit fix",
    "clean": "rimraf dist coverage .nyc_output",
    "precommit": "lint-staged",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@playwright/test": "^1.53.0",
    "@prisma/client": "^5.8.1",
    "@types/pg": "^8.15.4",
    "axios": "^1.9.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.6.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-security": "^2.1.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.2.4",
    "prisma": "^5.8.1",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "task-management",
    "backend",
    "api",
    "express",
    "typescript",
    "prisma",
    "redis",
    "postgresql",
    "process-engineering"
  ],
  "author": "Process Engineering Approach",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toshikazuyokoi/AIcoding-ProcessEngineering-Validation.git",
    "directory": "backend"
  },
  "bugs": {
    "url": "https://github.com/toshikazuyokoi/AIcoding-ProcessEngineering-Validation/issues"
  },
  "homepage": "https://github.com/toshikazuyokoi/AIcoding-ProcessEngineering-Validation#readme",
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run quality-check"
    }
  },
  "volta": {
    "node": "20.11.0",
    "npm": "10.2.4"
  }
}
