# Generated for TSK-008-ENV-backend-dockerignore
# Project: Task Management System
# Component: Backend API Server
# Purpose: Optimize Docker build performance and security

# ===================================
# Node.js & npm
# ===================================
# Dependencies (will be installed in container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/
.pnp.*

# Package lock files (keep package-lock.json for reproducible builds)
yarn.lock
pnpm-lock.yaml

# ===================================
# Build & Distribution
# ===================================
# Build outputs (will be generated in container)
dist/
build/
out/
*.tsbuildinfo

# Coverage reports
coverage/
.nyc_output/
*.lcov

# ===================================
